@model IEnumerable<QuanLyKhoaHoc.Models.KhoaHoc>
@using QuanLyKhoaHoc.Enums
@using QuanLyKhoaHoc.Extensions
@using QuanLyKhoaHoc.Helpers

@{
    ViewData["Title"] = "Danh sách khóa học";
}

<h2>Danh sách khóa học</h2>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-5">
            <input type="text"
                   name="searchString"
                   value="@ViewData["CurrentFilter"]"
                   class="form-control"
                   placeholder="Tìm theo khóa học / giảng viên..." />
        </div>

        <div class="col-md-3">
            <select name="trangThai" asp-items="ViewBag.TrangThaiList" class="form-control">
                <option value="">-- Tất cả trạng thái --</option>
            </select>
        </div>

        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a asp-action="Index" class="btn btn-secondary">Làm mới</a>
            <a asp-action="Create" class="btn btn-success">Thêm khóa học</a>
        </div>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Tên khóa học</th>
            <th>Giảng viên</th>
            <th>Học phí</th>
            <th>Số buổi</th>
            <th>Ngày bắt đầu</th>
            <th>Trạng thái</th>
            <th style="width:220px;">Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.strTenKhoaHoc</td>
                <td>@item.GiangVien?.strHoTen</td>
                <td>@item.HocPhi.ToHocPhiVN()</td>
                <td>@item.SoBuoiHoc</td>
                <td>@item.dtNgayBatDau.ToNgayVN()</td>
                <td>@item.TrangThai.LayTenHienThi()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>