@model IEnumerable<QuanLyKhoaHoc.Models.GiangVien>

@{
    ViewData["Title"] = "Danh sách giảng viên";
}

<h2>Danh sách giảng viên</h2>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="searchString"
               value="@ViewData["CurrentFilter"]"
               class="form-control"
               placeholder="Tìm theo họ tên hoặc khóa học..." />

        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-secondary">Làm mới</a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">Thêm giảng viên</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Họ và tên</th>
            <th>Email</th>
            <th>Số điện thoại</th>
            <th>Chuyên môn</th>
            <th>Kinh nghiệm</th>
            <th>Số khóa học</th>
            <th style="width: 220px;">Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.strHoTen</td>
                <td>@item.strEmail</td>
                <td>@item.strSoDienThoai</td>
                <td>@item.strChuyenMon</td>
                <td>@item.SoNamKinhNghiem năm</td>
                <td>@item.lstKhoaHocs.Count</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>