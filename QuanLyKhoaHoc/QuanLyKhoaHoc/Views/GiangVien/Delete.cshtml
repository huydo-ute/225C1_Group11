@model QuanLyKhoaHoc.Models.GiangVien

@{
    ViewData["Title"] = "Xóa giảng viên";
}

<h2>Xóa giảng viên</h2>

<h5 class="text-danger">Bạn có chắc chắn muốn xóa giảng viên này không?</h5>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Mã giảng viên</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Họ và tên</dt>
            <dd class="col-sm-9">@Model.strHoTen</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.strEmail</dd>

            <dt class="col-sm-3">Số điện thoại</dt>
            <dd class="col-sm-9">@Model.strSoDienThoai</dd>

            <dt class="col-sm-3">Chuyên môn</dt>
            <dd class="col-sm-9">@Model.strChuyenMon</dd>

            <dt class="col-sm-3">Số năm kinh nghiệm</dt>
            <dd class="col-sm-9">@Model.SoNamKinhNghiem năm</dd>

            <dt class="col-sm-3">Số khóa học phụ trách</dt>
            <dd class="col-sm-9">@Model.lstKhoaHocs.Count</dd>
        </dl>
    </div>
</div>

@if (Model.lstKhoaHocs != null && Model.lstKhoaHocs.Any())
{
    <div class="alert alert-warning mt-3">
        Không nên xóa giảng viên này vì đang phụ trách khóa học.
    </div>
}

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>