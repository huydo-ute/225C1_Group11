@model QuanLyKhoaHoc.Models.GiangVien

@{
    ViewData["Title"] = "Sửa giảng viên";
}

<h2>Sửa giảng viên</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="strHoTen" class="form-label"></label>
        <input asp-for="strHoTen" class="form-control" />
        <span asp-validation-for="strHoTen" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="strEmail" class="form-label"></label>
        <input asp-for="strEmail" class="form-control" />
        <span asp-validation-for="strEmail" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="strSoDienThoai" class="form-label"></label>
        <input asp-for="strSoDienThoai" class="form-control" />
        <span asp-validation-for="strSoDienThoai" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="strChuyenMon" class="form-label"></label>
        <input asp-for="strChuyenMon" class="form-control" />
        <span asp-validation-for="strChuyenMon" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SoNamKinhNghiem" class="form-label"></label>
        <input asp-for="SoNamKinhNghiem" class="form-control" />
        <span asp-validation-for="SoNamKinhNghiem" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-warning">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}